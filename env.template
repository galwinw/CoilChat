# ==================================================
# Coil.ai Environment Configuration
# ==================================================
#
# SETUP:
#   1. Copy this file:  cp env.template .env
#   2. Add your API key(s) below
#   3. Change all "CHANGE_ME" values to random strings
#   4. Run: docker compose up -d
#
# Generate random keys at: https://generate-secret.vercel.app/32
# ==================================================


# ===========================================
# AI Provider API Keys (at least one required)
# ===========================================

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI (GPT-4, etc.)
OPENAI_API_KEY=


# ===========================================
# Security Keys - MUST CHANGE THESE!
# ===========================================

# Session encryption (must be exactly 32 characters)
CREDS_KEY=CHANGE_ME_TO_32_RANDOM_CHARS_XX

# Initialization vector (must be exactly 16 characters)
CREDS_IV=CHANGE_ME_16_CHAR

# JWT token signing
JWT_SECRET=CHANGE_ME_RANDOM_JWT_SECRET_KEY

# Refresh token signing
JWT_REFRESH_SECRET=CHANGE_ME_RANDOM_REFRESH_KEY

# Meilisearch admin key
MEILI_MASTER_KEY=CHANGE_ME_MEILI_KEY


# ===========================================
# Server Configuration
# ===========================================
HOST=0.0.0.0
PORT=3080


# ===========================================
# Database & Services (Docker defaults - no changes needed)
# ===========================================
MONGO_URI=mongodb://mongodb:27017/LibreChat
MEILI_HOST=http://meilisearch:7700


# ===========================================
# User Registration
# ===========================================
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false


# ===========================================
# Docker (Windows users leave as 1000)
# ===========================================
UID=1000
GID=1000


# ===========================================
# Optional: Additional AI Providers
# ===========================================
# GOOGLE_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_KEY=

# Azure OpenAI
# AZURE_API_KEY=
# AZURE_OPENAI_API_INSTANCE_NAME=
# AZURE_OPENAI_API_DEPLOYMENT_NAME=
# AZURE_OPENAI_API_VERSION=


# ===========================================
# Optional: Debug Mode
# ===========================================
# DEBUG_LOGGING=true
# DEBUG_CONSOLE=true
