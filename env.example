# ==================================================
# LibreChat Environment Configuration for Coil.ai
# ==================================================
# RENAME THIS FILE TO .env BEFORE STARTING

# ===========================================
# Server Configuration
# ===========================================
HOST=0.0.0.0
PORT=3080

# ===========================================
# Credentials - CHANGE THESE!
# ===========================================
# Used for session management - generate a random string
CREDS_KEY=your-32-char-random-string-here1
CREDS_IV=your-16-char-str1

# JWT Secret - generate a random string for token signing
JWT_SECRET=your-super-secret-jwt-key-change-me

# Refresh token secret
JWT_REFRESH_SECRET=your-refresh-token-secret-change-me

# ===========================================
# MongoDB Configuration (uses Docker container)
# ===========================================
MONGO_URI=mongodb://mongodb:27017/LibreChat

# ===========================================
# Meilisearch (for message search)
# ===========================================
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=your-meilisearch-master-key

# ===========================================
# RAG API Configuration
# ===========================================
RAG_PORT=8000
RAG_API_URL=http://rag_api:8000
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small

# ===========================================
# AI Provider API Keys
# Add the ones you want to use
# ===========================================

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Anthropic (Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Azure OpenAI (if using)
# AZURE_API_KEY=
# AZURE_OPENAI_API_INSTANCE_NAME=
# AZURE_OPENAI_API_DEPLOYMENT_NAME=
# AZURE_OPENAI_API_VERSION=

# Google AI (Gemini)
# GOOGLE_KEY=

# ===========================================
# Optional: Custom Endpoints (from librechat.yaml)
# ===========================================
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_KEY=

# ===========================================
# User System
# ===========================================
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false

# Session expiry (15 minutes)
SESSION_EXPIRY=1000 * 60 * 15

# Refresh token expiry (7 days)
REFRESH_TOKEN_EXPIRY=(1000 * 60 * 60 * 24) * 7

# ===========================================
# Docker User Configuration
# Set these to your user/group IDs to avoid permission issues
# On Windows, you can leave these as 1000
# ===========================================
UID=1000
GID=1000

# ===========================================
# Debug (set to true for troubleshooting)
# ===========================================
DEBUG_LOGGING=false
DEBUG_CONSOLE=false

